<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AnimeGirlsDownloader.UserControls.Tag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AnimeGirlsDownloader.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Margin="0,0,5,0"
        Padding="10"
        Background="{ThemeResource TagBackgroundColor}"
        CornerRadius="15">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon VerticalAlignment="Center" Glyph="&#xE8EC;" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind TagText, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>

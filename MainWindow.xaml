<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AnimeGirlsDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AnimeGirlsDownloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="AnimeGirlsDownloader"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="TitleBarGrid"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <StackPanel
                Margin="15,10,15,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="AppTitle_TextBlock"
                    VerticalAlignment="Stretch"
                    FontSize="20"
                    FontWeight="Bold" />
            </StackPanel>
            <AutoSuggestBox
                x:Name="SearchTagsAutoSuggestBox"
                x:Uid="SearchTags_AutoSuggestBox"
                Width="300"
                Margin="15,10,15,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                QueryIcon="Find"
                QuerySubmitted="SearchTagsAutoSuggestBox_QuerySubmitted" />
            <StackPanel
                Margin="0,10,15,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="10">
                <Ellipse
                    x:Name="WindowControlMaximizeEllipse"
                    Fill="{ThemeResource WindowControlMaximizeEllipseColor}"
                    PointerReleased="WindowControlMaximizeEllipse_PointerReleased"
                    Style="{StaticResource WindowControlEllipse}" />
                <Ellipse
                    x:Name="WindowControlMinimizeEllipse"
                    Fill="{ThemeResource WindowControlMinimizeEllipseColor}"
                    PointerReleased="WindowControlMinimizeEllipse_PointerReleased"
                    Style="{StaticResource WindowControlEllipse}" />
                <Ellipse
                    x:Name="WindowControlCloseEllipse"
                    Fill="{ThemeResource WindowControlCloseEllipseColor}"
                    PointerReleased="WindowControlCloseEllipse_PointerReleased"
                    Style="{StaticResource WindowControlEllipse}" />
            </StackPanel>

        </Grid>
        <Grid Grid.Row="1" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource AppBarSeparatorForegroundThemeBrush}"
                BorderThickness="0.5" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="DisplayResultImageGrid"
                Grid.Column="0"
                Padding="10">
                <Grid x:Name="DisplayImageGrid">
                    <Image
                        x:Name="DisplayImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Name="CopyImageMenuFlyoutItem"
                                    x:Uid="CopyImage_MenuFlyoutItem"
                                    Click="CopyImageMenuFlyoutItem_Click"
                                    Icon="Copy" />
                                <MenuFlyoutItem
                                    x:Name="CopyImageLinkMenuFlyoutItem"
                                    x:Uid="CopyImageLink_MenuFlyoutItem"
                                    Click="CopyImageLinkMenuFlyoutItem_Click"
                                    Icon="Link" />
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                </Grid>
                <ProgressRing
                    x:Name="ImageLoadingProgressRing"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <Grid
                    x:Name="UploadImagePageGrid"
                    Canvas.ZIndex="100"
                    CornerRadius="10">
                    <Frame x:Name="UploadImagePageFrame" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1" CornerRadius="25,0,0,25">
                <Border Padding="10" CornerRadius="25,0,0,25">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Spacing="5">
                        <Button
                            x:Name="SaveImageButton"
                            x:Uid="SaveImage_Button"
                            Click="SaveImageButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE896;" />
                        </Button>
                        <Button
                            x:Name="RefreshButton"
                            x:Uid="Refresh_Button"
                            Click="RefreshButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            x:Name="ChangeThemeButton"
                            x:Uid="ChangeTheme_Button"
                            Click="ChangeThemeButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xEA80;" />
                        </Button>
                        <Button
                            x:Name="OpenSavingPathButton"
                            x:Uid="OpenSavingPath_Button"
                            Click="OpenSavingPathButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE8B7;" />
                        </Button>
                        <Button
                            x:Name="UploadImageButton"
                            x:Uid="UploadImage_Button"
                            Click="UploadImageButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE898;" />
                        </Button>

                        <Button
                            x:Name="SettingButton"
                            x:Uid="Setting_Button"
                            Click="SettingButton_Click"
                            Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE713;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="InfoBarContainerGrid" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="InfoBarGrid" Grid.Column="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>

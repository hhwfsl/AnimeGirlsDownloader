<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AnimeGirlsDownloader.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AnimeGirlsDownloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical" Spacing="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Ellipse
                    x:Name="UserAvatarEllipse"
                    Width="100"
                    Height="100"
                    Margin="0,0,0,10">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="UserAvatarImageBrush" />
                    </Ellipse.Fill>
                    <Ellipse.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="EditUserAvatarMenuFlyoutItem"
                                x:Uid="EditUserAvatar_MenuFlyoutItem"
                                Click="EditUserAvatarMenuFlyoutItem_Click"
                                Icon="Edit" />
                        </MenuFlyout>
                    </Ellipse.ContextFlyout>
                </Ellipse>
                <TextBlock
                    x:Name="UserNameTextBlock"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold">
                    <TextBlock.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="EditUserNameMenuFlyoutItem"
                                x:Uid="EditUserName_MenuFlyoutItem"
                                Click="EditUserNameMenuFlyoutItem_Click"
                                Icon="Edit" />
                        </MenuFlyout>
                    </TextBlock.ContextFlyout>
                </TextBlock>
                <TextBox
                    x:Name="UserNameTextBox"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    KeyDown="UserNameTextBox_KeyDown"
                    LostFocus="UserNameTextBox_LostFocus"
                    Visibility="Collapsed" />
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="40">
                    <Button
                        x:Name="LoginButton"
                        Click="LoginButton_Click"
                        Style="{StaticResource TextButton}">
                        <TextBlock
                            x:Uid="LoginButton_TextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </Button>
                    <StackPanel
                        x:Name="LoggedStackPanel"
                        Orientation="Horizontal"
                        Spacing="5">
                        <TextBlock
                            x:Uid="LoggedAccount_TextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="LoggedAccountNameTextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </StackPanel>
                    <Button
                        x:Name="LogoutButton"
                        Click="LogoutButton_Click"
                        Style="{StaticResource TextButton}">
                        <TextBlock
                            x:Uid="LogoutButton_TextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBarSeparatorForegroundThemeBrush}"
                    BorderThickness="0.5" />
            </Grid>
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="10">
                <CheckBox
                    x:Name="IsEnableNSFWCheckBox"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="IsEnableNSFWCheckBox_Checked"
                    Indeterminate="IsEnableNSFWCheckBox_Indeterminate"
                    IsThreeState="True"
                    Unchecked="IsEnableNSFWCheckBox_Unchecked" />
                <CheckBox
                    x:Name="IsEnableAiGeneratedCheckBox"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="IsEnableAiGeneratedCheckBox_Checked"
                    Indeterminate="IsEnableAiGeneratedCheckBox_Indeterminate"
                    IsThreeState="True"
                    Unchecked="IsEnableAiGeneratedCheckBox_Unchecked" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBarSeparatorForegroundThemeBrush}"
                    BorderThickness="0.5" />
            </Grid>
            <CheckBox
                x:Name="IsEnableFixedSavingPathCheckBox"
                x:Uid="IsEnableFixedSavingPath_CheckBox"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Checked="IsEnableFixedSavingPathCheckBox_Checked"
                Unchecked="IsEnableFixedSavingPathCheckBox_Unchecked" />
            <StackPanel
                x:Name="PathSelectStackPanel"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock
                    x:Uid="SavingPath_TextBlock"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <HyperlinkButton
                    x:Name="PathSelectButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="PathSelectButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Glyph="&#xE838;" />
                        <TextBlock
                            x:Uid="PathSelectButtonBrowse_TextBlock"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBarSeparatorForegroundThemeBrush}"
                    BorderThickness="0.5" />
            </Grid>
            <HyperlinkButton
                x:Name="ResizeWindowButton"
                Width="Auto"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="ResizeWindowButton_Click">
                <TextBlock
                    x:Uid="ResizeWindowButtonResizeToDefaultSize_TextBlock"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            </HyperlinkButton>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBarSeparatorForegroundThemeBrush}"
                    BorderThickness="0.5" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    x:Uid="ChangeLanguage_TextBlock"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    x:Name="LanguageListComboBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    SelectionChanged="LanguageListComboBox_SelectionChanged">
                    <x:String>English (US)</x:String>
                    <x:String>简体中文 (中国)</x:String>
                    <x:String>日本語 (日本)</x:String>
                </ComboBox>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBarSeparatorForegroundThemeBrush}"
                    BorderThickness="0.5" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>

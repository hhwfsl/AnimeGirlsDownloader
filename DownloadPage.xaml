<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AnimeGirlsDownloader.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AnimeGirlsDownloader.Models">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock
                x:Uid="DownloadPageTitle_TextBlock"
                FontSize="24"
                FontWeight="SemiBold" />
            <Button
                x:Uid="DownloadPageClose_Button"
                HorizontalAlignment="Right"
                Click="CloseButton_Click" />
        </Grid>
        <ListView
            x:Name="DownloadListView"
            Grid.Row="1"
            Margin="0,16,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind DisplayName}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                        <ProgressBar
                            Grid.Column="2"
                            Height="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Maximum="100"
                            ToolTipService.ToolTip="{x:Bind ProgressToolTip, Mode=OneWay}"
                            Value="{x:Bind Progress, Mode=OneWay}" />
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Uid="DownloadPageRetry_Button"
                                Click="RetryButton_Click"
                                IsEnabled="{x:Bind CanRetry, Mode=OneWay}"
                                Tag="{x:Bind}" />
                            <Button
                                x:Uid="DownloadPageCancel_Button"
                                Click="CancelButton_Click"
                                IsEnabled="{x:Bind CanCancel, Mode=OneWay}"
                                Tag="{x:Bind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
